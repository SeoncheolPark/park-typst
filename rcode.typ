#import "styles.typ": style-defaults
// syntax highlighting functions from skylighting:
/* Function definitions for syntax highlighting generated by skylighting: */
// One grid row per source line; token functions below only style text.
#let EndLine() = linebreak()
#let Skylighting(fill: none, number: false, start: 1, sourcelines) = {
  set text(font: style-defaults.mono-font, size: 9pt)
  // Override lecture's inline-code box rule for individual tokens.
  show raw.where(block: false): it => it
  let rows = sourcelines.enumerate().map(((i, ln)) => {
    if number {
      grid(columns: (if start + sourcelines.len() > 999 { 30pt } else { 24pt }, 1fr),
        column-gutter: 4pt,
        text(fill: rgb("#aaaaaa"), str(start + i)),
        ln,
      )
    } else { block(width: 100%, ln) }
  })
  block(fill: if fill == none { rgb("#f1f3f5") } else { fill },
    width: 100%, inset: 8pt, radius: 2pt, breakable: true,
    stack(dir: ttb, spacing: 2pt, ..rows),
  )
}
